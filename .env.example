# Environment variables for the Demo Orchestrator deploy script
# (scripts/deploy_script_include.js) and any other tooling that needs
# direct ServiceNow REST access.
#
# Copy this file to ".env" and fill in your real values. ".env" is in
# .gitignore so it will not be committed.
#
# Usage:
#   1. cp .env.example .env
#   2. Edit .env with your instance + credentials.
#   3. Source it before running the deploy:
#        set -a; source .env; set +a
#        node scripts/deploy_script_include.cjs
#
#   Or pass them inline for a single run:
#        SN_INSTANCE=your-instance.service-now.com \
#        SN_USERNAME=admin \
#        SN_PASSWORD='********' \
#        node scripts/deploy_script_include.cjs

# ServiceNow instance hostname (no protocol, no trailing slash).
SN_INSTANCE=your-instance.service-now.com

# Admin user with rights to create sys_script_include + sys_ws_definition
# in the global scope. A standard "admin" account works on a PDI.
SN_USERNAME=your_username

# Password for the user above. Wrap in single quotes if it contains
# shell-special characters.
SN_PASSWORD='your_password'
